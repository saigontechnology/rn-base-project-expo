# Component Development and UI Integration

## Component Architecture Overview

Follows a hierarchical component structure with theme integration and accessibility support.

### Component Priority System

1. **Priority 1**: Local custom components from [src/components/](mdc:src/components)
2. **Priority 2**: `rn-base-component` library for consistent UI elements
3. **Priority 3**: React Native base components (only when necessary)

### Available Local Components

- **Layout**: `ScreenContainer`, `ThemedView`, `Row`
- **Navigation**: `Header`, `HapticTab`
- **Input**: `TextInput`, `Selection`, `ChipSelection`, `DatePicker`, `CodeInput`
- **Form**: [src/components/form/](mdc:src/components/form) - `FormInput`, `FormPhoneInput`, `FormSelection`, etc.
- **Feedback**: `Toast`, `IndicatorDialog`
- **Interactive**: `Collapsible`, `Draggable`, `BottomSheet`
- **Typography**: `ThemedText`, `IconSymbol`

## Component Development Patterns

### Basic Component Structure

```typescript
import React from 'react'
import { StyleSheet, View, ViewStyle } from 'react-native'
import { ThemedText } from '@/components/ThemedText'
import { metrics, theme } from '@/themes'

interface ComponentProps {
  title?: string
  onPress?: () => void
  disabled?: boolean
  containerStyle?: ViewStyle
  testID?: string
}

export const CustomComponent: React.FC<ComponentProps> = ({
  title,
  onPress,
  disabled = false,
  containerStyle,
  testID,
}) => {

  return (
    <View
      style={[styles.container, containerStyle]}
      testID={testID}
    >
      <ThemedText type="title">{title}</ThemedText>
    </View>
  )
}

const styles = StyleSheet.create({
  container: {
    padding: metrics.medium,
    borderRadius: metrics.borderRadius,
    backgroundColor: theme.colors.backgroundColor
  },
})
```

### Screen Component Structure

```typescript
import React, { useCallback } from 'react'
import { StyleSheet, View, Image } from 'react-native'
import { useForm } from 'react-hook-form'
import { zodResolver } from '@hookform/resolvers/zod'
import { ButtonPrimary } from 'rn-base-component'

import { ScreenContainer } from '@/components/ScreenContainer'
import { Header } from '@/components/Header'
import { FormInput } from '@/components/form'
import { ThemedText } from '@/components/ThemedText'
import { Images, metrics } from '@/themes'
import { getString } from '@/locale/I18nConfig'
import { useAppDispatch, useSelector } from '@/stores/store'

export const ExampleScreen: React.FC = () => {
  const dispatch = useAppDispatch()
  const isLoading = useSelector(selectLoading)

  const {
    control,
    handleSubmit,
    formState: { isValid },
  } = useForm({
    resolver: zodResolver(ValidationSchema),
    defaultValues: { field: '' },
    mode: 'onChange',
  })

  const onSubmit = useCallback((data: FormData) => {
    dispatch(actions.submit(data))
  }, [dispatch])

  return (
    <ScreenContainer style={styles.container}>
      <Header title={getString('screen.title')} />

      <View style={styles.content}>
        <Image source={Images.logo} style={styles.logo} resizeMode="contain" />

        <ThemedText type="title">{getString('screen.heading')}</ThemedText>

        <FormInput
          control={control}
          id="field"
          label={getString('field.label')}
          placeholder={getString('field.placeholder')}
        />

        <ButtonPrimary
          onPress={handleSubmit(onSubmit)}
          disabled={!isValid || isLoading}
        >
          {isLoading ? getString('common.loading') : getString('common.submit')}
        </ButtonPrimary>
      </View>
    </ScreenContainer>
  )
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
  },
  content: {
    flex: 1,
    padding: metrics.large,
  },
  logo: {
    width: metrics.logoWidth,
    height: metrics.logoHeight,
    alignSelf: 'center',
    marginBottom: metrics.large,
  },
})
```

## Button Component Patterns

### Button Variants from rn-base-component

```typescript
import {
  ButtonPrimary,
  ButtonSecondary,
  ButtonOutline,
  ButtonTransparent
} from 'rn-base-component'

// Primary action button
<ButtonPrimary onPress={handleSubmit}>
  {getString('common.submit')}
</ButtonPrimary>

// Secondary action button
<ButtonSecondary onPress={handleCancel}>
  {getString('common.cancel')}
</ButtonSecondary>

// Outline button for less emphasis
<ButtonOutline onPress={handleEdit}>
  {getString('common.edit')}
</ButtonOutline>

// Transparent button for links/minimal actions
<ButtonTransparent onPress={handleForgotPassword}>
  {getString('auth.forgotPassword')}
</ButtonTransparent>
```

### Button State Management

```typescript
const ExampleForm: React.FC = () => {
  const isLoading = useSelector(selectLoading)
  const { formState: { isValid } } = useForm()

  return (
    <ButtonPrimary
      onPress={handleSubmit(onSubmit)}
      disabled={!isValid || isLoading}
      style={styles.submitButton}
    >
      {isLoading ? getString('common.processing') : getString('common.submit')}
    </ButtonPrimary>
  )
}
```

## Input Component Patterns

### Text Input with Theme Integration

```typescript
import { TextInput } from '@/components/TextInput'

<TextInput
  label={getString('field.label')}
  placeholder={getString('field.placeholder')}
  value={value}
  onChangeText={onChangeText}
  errorText={error}
  leftComponent={<Icon name="email" />}
  rightComponent={showPassword ? <EyeIcon /> : null}
  secureTextEntry={!showPassword}
  keyboardType="email-address"
  autoComplete="email"
  textContentType="emailAddress"
  testID="email-input"
/>
```

### Selection Components

```typescript
import { Selection } from '@/components/Selection'

<Selection
  data={options}
  value={selectedValue}
  onItemSelected={handleSelection}
  label={getString('field.label')}
  placeholder={getString('field.placeholder')}
  renderItem={({ item }) => <Text>{item.label}</Text>}
  getTitle={(item) => item.label}
  getValue={(item) => item.value}
  snapPoints={['50%']}
  hasSearch={true}
/>
```

