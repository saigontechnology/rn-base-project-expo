## Redux Testing

### Reducer Tests

```typescript
// __tests__/stores/reducers/user.test.ts
import userReducer, { userActions } from '@/stores/reducers/user'
import { UserState } from '@/stores/types/user'

const initialState: UserState = {
  profile: null,
  isAuthenticated: false,
  loading: false,
  error: null,
}

describe('userReducer', () => {
  it('should return initial state', () => {
    expect(userReducer(undefined, { type: 'unknown' })).toEqual(initialState)
  })

  it('should handle loginRequest', () => {
    const action = userActions.loginRequest({ phone: '+84123456789', password: 'password' })
    const state = userReducer(initialState, action)

    expect(state.loading).toBe(true)
    expect(state.error).toBeNull()
  })

  it('should handle loginSuccess', () => {
    const mockUser = {
      id: '1',
      phone: '+84123456789',
      firstName: 'John',
      lastName: 'Doe',
    }

    const action = userActions.loginSuccess(mockUser)
    const state = userReducer(initialState, action)

    expect(state.profile).toEqual(mockUser)
    expect(state.isAuthenticated).toBe(true)
    expect(state.loading).toBe(false)
    expect(state.error).toBeNull()
  })

  it('should handle loginFailure', () => {
    const errorMessage = 'Invalid credentials'
    const action = userActions.loginFailure(errorMessage)
    const state = userReducer(initialState, action)

    expect(state.profile).toBeNull()
    expect(state.isAuthenticated).toBe(false)
    expect(state.loading).toBe(false)
    expect(state.error).toBe(errorMessage)
  })
})
```

### Saga Tests

```typescript
// __tests__/stores/saga/user.test.ts
import { runSaga } from 'redux-saga'
import { call, put } from 'redux-saga/effects'
import { loginSaga } from '@/stores/saga/user'
import { userActions } from '@/stores/reducers/user'
import { loginApi } from '@/services/api/user'

describe('loginSaga', () => {
  it('should handle successful login', async () => {
    const mockUser = {
      id: '1',
      phone: '+84123456789',
      firstName: 'John',
      lastName: 'Doe',
    }

    const mockResponse = {
      success: true,
      data: mockUser,
      message: 'Login successful',
    }

    const dispatched: any[] = []
    const saga = runSaga(
      {
        dispatch: action => dispatched.push(action),
        getState: () => ({}),
      },
      loginSaga,
      userActions.loginRequest({ phone: '+84123456789', password: 'password' }),
    )

    // Mock the API call
    jest.spyOn(require('@/services/api/user'), 'loginApi').mockResolvedValue(mockResponse)

    await saga.toPromise()

    expect(dispatched).toContainEqual(
      expect.objectContaining({
        type: userActions.loginSuccess.type,
        payload: mockUser,
      }),
    )
  })

  it('should handle login failure', async () => {
    const errorMessage = 'Invalid credentials'
    const mockResponse = {
      success: false,
      message: errorMessage,
    }

    const dispatched: any[] = []
    const saga = runSaga(
      {
        dispatch: action => dispatched.push(action),
        getState: () => ({}),
      },
      loginSaga,
      userActions.loginRequest({ phone: '+84123456789', password: 'wrongpassword' }),
    )

    jest.spyOn(require('@/services/api/user'), 'loginApi').mockResolvedValue(mockResponse)

    await saga.toPromise()

    expect(dispatched).toContainEqual(
      expect.objectContaining({
        type: userActions.loginFailure.type,
        payload: errorMessage,
      }),
    )
  })

  it('should handle network errors', async () => {
    const networkError = new Error('Network Error')

    const dispatched: any[] = []
    const saga = runSaga(
      {
        dispatch: action => dispatched.push(action),
        getState: () => ({}),
      },
      loginSaga,
      userActions.loginRequest({ phone: '+84123456789', password: 'password' }),
    )

    jest.spyOn(require('@/services/api/user'), 'loginApi').mockRejectedValue(networkError)

    await saga.toPromise()

    expect(dispatched).toContainEqual(
      expect.objectContaining({
        type: userActions.loginFailure.type,
        payload: 'Network Error',
      }),
    )
  })
})
```

### Selector Tests

```typescript
// __tests__/stores/selectors/user.test.ts
import { selectUserInfo, selectIsAuthenticated } from '@/stores/selectors/user'
import { RootState } from '@/stores/types'

const createMockState = (userState: any): RootState =>
  ({
    user: userState,
    app: {},
    loading: {},
    // ... other state slices
  }) as RootState

describe('user selectors', () => {
  describe('selectUserInfo', () => {
    it('should return user profile when authenticated', () => {
      const mockUser = {
        id: '1',
        phone: '+84123456789',
        firstName: 'John',
        lastName: 'Doe',
      }

      const state = createMockState({
        profile: mockUser,
        isAuthenticated: true,
      })

      expect(selectUserInfo(state)).toEqual(mockUser)
    })

    it('should return null when not authenticated', () => {
      const state = createMockState({
        profile: null,
        isAuthenticated: false,
      })

      expect(selectUserInfo(state)).toBeNull()
    })
  })

  describe('selectIsAuthenticated', () => {
    it('should return true when user is authenticated', () => {
      const state = createMockState({
        isAuthenticated: true,
      })

      expect(selectIsAuthenticated(state)).toBe(true)
    })

    it('should return false when user is not authenticated', () => {
      const state = createMockState({
        isAuthenticated: false,
      })

      expect(selectIsAuthenticated(state)).toBe(false)
    })
  })
})
