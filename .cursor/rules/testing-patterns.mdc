## API Testing

### API Service Tests

```typescript
// __tests__/services/api/user.test.ts
import { loginApi, registerApi } from '@/services/api/user'
import { mockAxiosInstance } from '../../__mocks__/axios'

jest.mock('@/services/networking/axios', () => mockAxiosInstance)

describe('User API', () => {
  beforeEach(() => {
    jest.clearAllMocks()
  })

  describe('loginApi', () => {
    it('should make POST request to login endpoint', async () => {
      const mockResponse = {
        data: {
          success: true,
          data: { id: '1', phone: '+84123456789' },
          message: 'Login successful',
        },
      }

      mockAxiosInstance.post.mockResolvedValue(mockResponse)

      const result = await loginApi({
        body: { phone: '+84123456789', password: 'password' },
      })

      expect(mockAxiosInstance.post).toHaveBeenCalledWith(
        '/auth/login',
        JSON.stringify({ phone: '+84123456789', password: 'password' }),
        expect.any(Object),
      )

      expect(result).toEqual(mockResponse.data)
    })

    it('should handle API errors', async () => {
      const mockError = {
        response: {
          status: 401,
          data: { message: 'Invalid credentials' },
        },
      }

      mockAxiosInstance.post.mockRejectedValue(mockError)

      await expect(
        loginApi({ body: { phone: '+84123456789', password: 'wrongpassword' } }),
      ).rejects.toMatchObject(mockError)
    })
  })

  describe('registerApi', () => {
    it('should make POST request to register endpoint', async () => {
      const mockResponse = {
        data: {
          success: true,
          message: 'OTP sent successfully',
        },
      }

      mockAxiosInstance.post.mockResolvedValue(mockResponse)

      const result = await registerApi({
        body: { phone: '+84123456789' },
      })

      expect(mockAxiosInstance.post).toHaveBeenCalledWith(
        '/auth/register',
        JSON.stringify({ phone: '+84123456789' }),
        expect.any(Object),
      )

      expect(result).toEqual(mockResponse.data)
    })
  })
})
```

