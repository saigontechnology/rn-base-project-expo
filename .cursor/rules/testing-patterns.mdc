## Mock Setup

### Mock Store

```typescript
// __tests__/__mocks__/store.ts
import { configureStore } from '@reduxjs/toolkit'
import { combineReducers } from 'redux'
import userReducer from '@/stores/reducers/user'
import appReducer from '@/stores/reducers/app'
import loadingReducer from '@/stores/reducers/loading'

const rootReducer = combineReducers({
  user: userReducer,
  app: appReducer,
  loading: loadingReducer,
})

export const createMockStore = (preloadedState?: any) => {
  return configureStore({
    reducer: rootReducer,
    preloadedState,
    middleware: getDefaultMiddleware =>
      getDefaultMiddleware({
        serializableCheck: false,
        immutableCheck: false,
      }),
  })
}
```

