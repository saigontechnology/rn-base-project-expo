## Authentication Flow Patterns

### Token Management

```typescript
// Login API with token storage
export const loginApi = async (req: RequestWithBody<LoginRequest>) => {
  const response = await postFormDataRequest<ApiBaseResponse<AuthResponse>>({
    url: AUTH_API.login,
    body: convertToFormData(req.body),
    config: { 'Content-Type': 'multipart/form-data' },
  })

  // Store tokens after successful login
  if (RESPONSE_CODE.success.includes(response.status)) {
    await setData('access_token', response.data.access_token)
    await setData('refresh_token', response.data.refresh_token)
  }

  return response
}

// Token refresh handling
const handleRefreshToken = async (refreshToken: string, originalConfig: any) => {
  try {
    const response = await refreshTokenApi({ body: { refresh_token: refreshToken } })

    if (RESPONSE_CODE.success.includes(response.status)) {
      await setData('access_token', response.data.access_token)
      await setData('refresh_token', response.data.refresh_token)

      // Retry original request with new token
      originalConfig.headers.Authorization = `Bearer ${response.data.access_token}`
      return instance(originalConfig)
    }
  } catch (error) {
    // Redirect to login if refresh fails
    await clearAllData()
    router.push(RouteKeys.SignIn)
  }
}
```

## File Upload Patterns

### Image/File Upload

```typescript
// Pet photo upload with FormData
export const uploadPetPhotoApi = async (petId: string, req: RequestWithBody<{ photo: any }>) => {
  const formData = new FormData()
  formData.append('photo', {
    uri: req.body.photo.uri,
    type: req.body.photo.type,
    name: req.body.photo.fileName || 'photo.jpg',
  } as any)

  return await postFormDataRequest<ApiBaseResponse<Pet>>({
    url: `${PET_API.uploadPetPhoto}/${petId}/upload-photo`,
    body: formData,
    config: { 'Content-Type': 'multipart/form-data' },
  })
}
```

## Pagination and Filtering

### Query Parameter Patterns

```typescript
// Paginated list with filters
export const getNotificationsApi = async (params?: {
  page?: number
  limit?: number
  type?: 'premia_status' | 'voucher_new' | 'voucher_expired' | 'referral_success' | 'promotional'
}) =>
  await getRequest<
    ApiBaseResponse<{
      notifications: Notification[]
      pagination: {
        current_page: number
        per_page: number
        total: number
        last_page: number
      }
    }>
  >({
    url: NOTIFICATION_API.getNotifications,
    params,
  })

// Search with dynamic parameters
export const searchRetailersApi = async (params: {
  keyword?: string
  latitude?: number
  longitude?: number
  radius?: number
  store_type?: string
}) =>
  await getRequest<
    ApiBaseResponse<{
