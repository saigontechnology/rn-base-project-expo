## Request Pattern Types

### RequestWithBody Pattern

```typescript
// Core request type for POST/PUT operations
export type RequestWithBody<P> = {
  body: P
  config?: Record<string, string> // For headers like Content-Type
}

// Usage in API functions
export const loginApi = async (req: RequestWithBody<LoginRequest>) =>
  await postFormDataRequest<ApiBaseResponse<AuthResponse>>({
    url: AUTH_API.login,
    body: convertToFormData(req.body),
    config: { 'Content-Type': 'multipart/form-data' },
  })
```

### HTTP Method Patterns

#### GET Requests (Direct Parameters)

```typescript
// Simple GET with query parameters
export const getRetailersApi = async (params?: {
  page?: number
  limit?: number
  store_type?: 'pet_shop' | 'vet' | 'grooming' | 'hotel' | 'home_delivery'
}) =>
  await getRequest<ApiBaseResponse<RetailersListResponse>>({
    url: RETAILER_API.getRetailers,
    params,
  })

// GET without parameters
export const getPointsBalanceApi = async () =>
  await getRequest<ApiBaseResponse<PointsBalance>>({
    url: POINTS_API.getBalance,
  })
```

#### POST Requests (RequestWithBody)

```typescript
// JSON POST request
export const redeemPremiaApi = async (req: RequestWithBody<RedemptionRequest>) =>
  await postRequest<ApiBaseResponse<PremiaRedemption>>({
    url: PREMIA_API.redeemPremia,
    body: req.body,
  })

// FormData POST request
export const registerApi = async (req: RequestWithBody<RegisterRequest>) =>
  await postFormDataRequest<ApiBaseResponse<RegisterResponse>>({
    url: AUTH_API.register,
    body: convertToFormData(req.body),
    config: { 'Content-Type': 'multipart/form-data' },
  })
```

#### PUT/DELETE Requests

```typescript
// PUT request for updates
export const updateUserProfileApi = async (req: RequestWithBody<UpdateProfileRequest>) =>
  await putRequest<ApiBaseResponse<User>>({
    url: USER_API.updateProfile,
    body: req.body,
  })

// DELETE request with ID parameter
export const deletePetApi = async (petId: string) =>
  await deleteRequest<ApiBaseResponse<void>>({
    url: `${PET_API.deletePet}/${petId}`,
  })
```

## Response Type Patterns

### Base Response Interface

```typescript
export interface ApiBaseResponse<T = unknown> {
  error: AxiosErrorResponse | null
  success: boolean
  message?: string
  status: number
  timestamp?: string
  data?: T
}

// Error response structure
export interface AxiosErrorResponse {
  data: Record<string, string[]>
  detail: unknown
  message: string
  requestId: string
  responseId: string
  success: false
}
```

### Feature-Specific Response Types

```typescript
// Authentication responses
export interface RegisterResponse extends ApiBaseResponse {
  data: {
    phone: string
    expires_in: number
    remaining_attempts: number
    next_step: 'verify_otp'
    otp?: string // Only in development
  }
}

export interface AuthResponse extends ApiBaseResponse {
  data: {
    access_token: string
    refresh_token: string
    token_type: 'Bearer'
    expires_in: number
    user: User
  }
}

// Paginated responses
export interface PremiaListResponse extends ApiBaseResponse {
  data: {
    premias: Premia[]
    pagination: {
      current_page: number
      per_page: number
      total: number
      last_page: number
    }
  }
}
```

## Networking Layer Configuration

### Axios Instance Setup

```typescript
import axios, { AxiosInstance, AxiosResponse, AxiosError } from 'axios'
import { getData, setData } from '@/utilities/storage'
import { RESPONSE_CODE, TOKEN } from '@/constants'

const instance: AxiosInstance = axios.create({
  baseURL: process.env.EXPO_PUBLIC_API_BASE_URL,
  timeout: 30000,
  headers: {
    'Content-Type': 'application/json',
    Accept: 'application/json',
  },
})

// Request interceptor for auth token
instance.interceptors.request.use(async config => {
  const token = await getData<string>(TOKEN.token)
  if (token) {
    config.headers.Authorization = `Bearer ${token}`
  }
  return config
})

// Response interceptor for token refresh
instance.interceptors.response.use(
  (response: AxiosResponse) => response,
  async (error: AxiosError) => {
    const originalConfig = error?.config
    const token = await getData<string>(TOKEN.token)
    const refreshToken = await getData<string>(TOKEN.refreshToken)
    const isTokenExpired = token && RESPONSE_CODE.unauthorized.includes(error?.response?.status as number)

    if (isTokenExpired && refreshToken) {
      // Handle token refresh logic
      return handleRefreshToken(refreshToken, originalConfig)
    }

    return Promise.reject(error)
  },
)
```

### HTTP Method Wrappers

```typescript
// GET request wrapper
export async function getRequest<TResponse>(request: { url: string; params?: unknown }): Promise<TResponse> {
  return axiosAPI<TResponse>({
    url: request.url,
    method: 'GET',
    params: request.params,
  })
}

// POST request wrapper
export async function postRequest<TResponse, TRequest = unknown>(request: {
  url: string
  body: TRequest
  config?: Record<string, string>
}): Promise<TResponse> {
  return axiosAPI<TResponse, TRequest>({
    url: request.url,
    method: 'POST',
    body: request.body,
    config: request.config,
  })
}

// FormData POST wrapper
export async function postFormDataRequest<TResponse>(request: {
  url: string
  body: FormData
  config?: Record<string, string>
}): Promise<TResponse> {
  return axiosAPI<TResponse, FormData>({
    url: request.url,
    method: 'POST',
    body: request.body,
    config: { 'Content-Type': 'multipart/form-data', ...request.config },
  })
}
```

## FormData Conversion Patterns

### Object to FormData Helper

```typescript
const convertToFormData = (data: unknown): FormData => {
  const formData = new FormData()
  const obj = data as Record<string, unknown>

  Object.keys(obj).forEach(key => {
    const value = obj[key]
    if (value !== undefined && value !== null) {
      formData.append(key, String(value))
    }
  })

  return formData
}

// Usage in API functions
export const registerApi = async (req: RequestWithBody<RegisterRequest>) =>
  await postFormDataRequest<ApiBaseResponse<RegisterResponse>>({
    url: AUTH_API.register,
    body: convertToFormData(req.body),
    config: { 'Content-Type': 'multipart/form-data' },
  })
```

## Error Handling Patterns

### Response Error Checking

```typescript
// Standard error checking pattern
const response: ApiResponse = await apiCall()

if (RESPONSE_CODE.success.includes(response.status)) {
  // Handle success
  return response.data
} else {
  // Handle API error response
  const errorMessage = response?.error?.message || 'Operation failed'
  throw new Error(errorMessage)
}
```

