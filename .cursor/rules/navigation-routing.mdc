# Navigation and Routing with Expo Router

## Navigation Architecture Overview

Use Expo Router for file-based routing with grouped authentication and app routes.

### Route Structure

```
app/
├── _layout.tsx           # Root layout with providers
├── index.tsx             # Entry point route
├── splash-screen.tsx     # Splash screen route
├── +not-found.tsx        # 404 error handling
├── (auth)/               # Authentication route group
│   ├── _layout.tsx       # Auth layout
│   ├── sign-in.tsx       # Login screen
│   ├── sign-up.tsx       # Registration screen
│   ├── verify-otp.tsx    # OTP verification
│   ├── forgot-password.tsx # Password reset
│   ├── setup-password.tsx # Password creation
│   ├── referral-code.tsx  # Referral code entry
│   └── success.tsx       # Success screen
└── (app)/                # Main app route group
    ├── _layout.tsx       # App layout with tabs
    ├── home.tsx          # Home screen
    └── about.tsx         # About screen
```

## Route Group Patterns

### Add route name in [src/routes/RouteKeys](mdc:src/routes/RouteKeys)

```typescript
export const RouteNames = {
  // auth
  SignIn: 'sign-in',
  SignUp: 'sign-up',
  VerifyOTP: 'verify-otp',
  SetupPassword: 'setup-password',
  ForgotPassword: 'forgot-password',
  Success: 'success',
  ReferralCode: 'referral-code',
}
```

### Authentication Route Group

```typescript
// app/(auth)/_layout.tsx
import React from 'react'
import { Stack } from 'expo-router'
import { ScreenOptions } from '@/routes/ScreenOptions'
import { RouteNames } from '@/routes/RouteKeys'

export default function AuthLayout() {
  return (
    <Stack
      screenOptions={{
        headerShown: false,
        ...ScreenOptions.authStack,
      }}>
      <Stack.Screen name={RouteNames.SignIn} />
      <Stack.Screen name={RouteNames.SignUp} />
      <Stack.Screen name={RouteNames.VerifyOTP} />
      <Stack.Screen name={RouteNames.SetupPassword} />
      <Stack.Screen name={RouteNames.ForgotPassword} />
      <Stack.Screen name={RouteNames.Success} />
      <Stack.Screen name={RouteNames.ReferralCode} />
    </Stack>
  )
}
```

### App Route Group with Tabs

```typescript
// app/(app)/_layout.tsx
import React from 'react'
import { Tabs } from 'expo-router'
import { HapticTab } from '@/components/HapticTab'
import { IconSymbol } from '@/components/IconSymbol'
import { theme } from '@/themes'
import { RouteNames } from '@/routes/RouteKeys'
import { getString } from '@/locale/I18nConfig'

export default function AppLayout() {
  return (
    <Tabs
      screenOptions={{
        headerShown: false,
        tabBarButton: HapticTab,
        tabBarActiveTintColor: theme.colors.primary,
        tabBarInactiveTintColor: theme.colors.gray,
        tabBarStyle: {
          backgroundColor: theme.colors.white,
          borderTopColor: theme.colors.border,
        },
      }}>
      <Tabs.Screen
        name={RouteNames.home}
        options={{
          title: getString('home.title'),
          tabBarIcon: ({ color, focused }) => (
            <IconSymbol name={focused ? 'home' : 'home-outline'} color={color} />
          ),
        }}
      />
      <Tabs.Screen
        name={RouteNames.about}
        options={{
          title:getString('about.title'),
          tabBarIcon: ({ color, focused }) => (
            <IconSymbol name={focused ? 'info' : 'info-outline'} color={color} />
          ),
        }}
      />
    </Tabs>
  )
}
```

## Route Constants

### Centralized Route Keys

```typescript
// src/routes/RouteKeys.ts
export const RouteKeys = {
  // Entry and Special
  Root: '/',
  SplashScreen: '/splash-screen',
  NotFound: '/+not-found',

  // Authentication
  SignIn: '/(auth)/sign-in',
  SignUp: '/(auth)/sign-up',
  VerifyOTP: '/(auth)/verify-otp',
  ForgotPassword: '/(auth)/forgot-password',
  SetupPassword: '/(auth)/setup-password',
  ReferralCode: '/(auth)/referral-code',
  Success: '/(auth)/success',

  // Main App
  Home: '/(app)/home',
  About: '/(app)/about',
} as const

export type RouteKey = (typeof RouteKeys)[keyof typeof RouteKeys]
```

## Navigation Patterns

### Basic Navigation

```typescript
import { router } from 'expo-router'
import { RouteKeys } from '@/routes/RouteKeys'

// Simple navigation
const navigateToHome = () => {
  router.push(RouteKeys.Home)
}

// Replace current route (no back navigation)
const navigateToSignIn = () => {
  router.replace(RouteKeys.SignIn)
}

// Go back
const goBack = () => {
  router.back()
}

// Navigate to root and reset stack
const resetToHome = () => {
  router.dismissAll()
  router.replace(RouteKeys.Home)
}
```

### Navigation with Parameters

```typescript
// Navigate with query parameters
const navigateToVerifyOTP = (phoneNumber: string) => {
  router.push({
    pathname: RouteKeys.VerifyOTP,
    params: { phone: phoneNumber },
  })
}

// Navigate with complex parameters
const navigateToSetupPassword = (phone: string, token: string, flow: string) => {
  router.push({
    pathname: RouteKeys.SetupPassword,
    params: {
      phone,
      token,
      flow,
    },
  })
}

// Accessing parameters in component
import { useLocalSearchParams } from 'expo-router'

export const VerifyOTPScreen: React.FC = () => {
  const { phone, flow } = useLocalSearchParams<{ phone?: string; flow?: string }>()

  // Use parameters in component logic
  const phoneNumber = phone as string
  const isResetFlow = flow === FLOW_TYPE.FORGOT_PASSWORD

  // Component logic...
}
```

### Conditional Navigation

```typescript
// Navigation based on authentication state
const handleAuthNavigation = useCallback((user: User | null) => {
  if (user) {
    // User is authenticated
    router.replace(RouteKeys.Home)
  } else {
    // User needs to authenticate
    router.replace(RouteKeys.SignIn)
  }
}, [])

// Navigation based on app state
const handleAppInitialization = useCallback(() => {
  // Check if app needs onboarding
  if (needsOnboarding) {
    router.replace(RouteKeys.SignUp)
  } else {
    router.replace(RouteKeys.SignIn)
  }
}, [needsOnboarding])
```

## Screen Configuration

### Screen Options

```typescript
// src/routes/ScreenOptions.ts
import { StackNavigationOptions } from '@react-navigation/stack'
import { theme, fonts, fontSizes, metrics } from '@/themes'

export const ScreenOptions = {
  authStack: {
    headerShown: false,
    gestureEnabled: true,
    animationTypeForReplace: 'push',
