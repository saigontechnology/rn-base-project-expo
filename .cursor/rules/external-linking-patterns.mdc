# External Linking Patterns

## Overview

Guidelines for safely and consistently handling external URL navigation in React Native applications.

## Core Implementation

### Required Imports

Always import necessary modules for external linking:

```tsx
import { Linking, Alert } from 'react-native'
```

### Basic Link Opening Pattern

Use consistent error handling for all external links:

```tsx
const handleLinkPress = useCallback((url: string, errorMessage: string) => {
  Linking.openURL(url).catch(() => {
    Alert.alert('Error', errorMessage)
  })
}, [])
```

### URL Validation

Validate URLs before attempting to open:

```tsx
const isValidURL = (url: string): boolean => {
  try {
    new URL(url)
    return true
  } catch {
    return false
  }
}

const handleSafeLinkPress = useCallback((url: string, errorMessage: string) => {
  if (!isValidURL(url)) {
    Alert.alert('Error', 'Invalid URL format')
    return
  }

  Linking.openURL(url).catch(() => {
    Alert.alert('Error', errorMessage)
  })
}, [])
```

## Common Link Types

### Terms of Service & Privacy Policy

```tsx
const TermsAndPrivacyLinks: React.FC = () => {
  const handleTermsPress = useCallback(() => {
    const termsUrl = 'https://royalcanin.com/terms-of-service'
    Linking.openURL(termsUrl).catch(() => {
      Alert.alert('Error', 'Unable to open Terms of Service')
    })
  }, [])

  const handlePrivacyPress = useCallback(() => {
    const privacyUrl = 'https://royalcanin.com/privacy-policy'
    Linking.openURL(privacyUrl).catch(() => {
      Alert.alert('Error', 'Unable to open Privacy Policy')
    })
  }, [])

  return (
    <Text style={styles.text}>
      <Text style={styles.link} onPress={handleTermsPress}>
        {getString('auth.term_of_service')}
      </Text>
      <Text> & </Text>
      <Text style={styles.link} onPress={handlePrivacyPress}>
        {getString('auth.privacy_policy')}
      </Text>
    </Text>
  )
}
```

