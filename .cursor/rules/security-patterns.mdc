## Input Validation

### Form Security

```typescript
// src/utils/inputValidation.ts
import { z } from 'zod'

export class InputValidation {
  // ✅ SQL injection prevention
  static sanitizeInput(input: string): string {
    return input
      .replace(/'/g, "''") // Escape single quotes
      .replace(/;/g, '') // Remove semicolons
      .replace(/--/g, '') // Remove SQL comments
      .replace(/\/\*/g, '') // Remove SQL block comments start
      .replace(/\*\//g, '') // Remove SQL block comments end
  }

  // ✅ XSS prevention
  static sanitizeHTML(input: string): string {
    return input
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#x27;')
      .replace(/\//g, '&#x2F;')
  }

  // ✅ Phone number validation
  static validatePhoneNumber(phone: string, countryCode: string): boolean {
    const phoneSchema = z
      .string()
      .min(8, 'Phone number too short')
      .max(15, 'Phone number too long')
      .regex(/^[0-9]+$/, 'Phone number must contain only digits')

    const countryCodeSchema = z.string().regex(/^\+[1-9]\d{1,14}$/, 'Invalid country code')

    try {
      phoneSchema.parse(phone)
      countryCodeSchema.parse(countryCode)
      return true
    } catch {
      return false
    }
  }

  // ✅ Email validation
  static validateEmail(email: string): boolean {
    const emailSchema = z.string().email('Invalid email format').max(254, 'Email too long') // RFC 5321 limit

    try {
      emailSchema.parse(email)
      return true
    } catch {
      return false
    }
  }

  // ✅ File upload validation
  static validateFileUpload(file: { uri: string; type?: string; size?: number }): {
    isValid: boolean
    error?: string
  } {
    const allowedTypes = ['image/jpeg', 'image/png', 'image/gif']
    const maxSize = 5 * 1024 * 1024 // 5MB

    if (file.type && !allowedTypes.includes(file.type)) {
      return { isValid: false, error: 'File type not allowed' }
    }

    if (file.size && file.size > maxSize) {
      return { isValid: false, error: 'File size too large' }
    }

    return { isValid: true }
  }
}
```

## Session Management

### Session Security

```typescript
// src/services/auth/sessionManager.ts
import { TokenManager } from './tokenManager'

export class SessionManager {
  private static sessionTimeout = 30 * 60 * 1000 // 30 minutes
  private static lastActivity = Date.now()

  // ✅ Session timeout management
  static updateActivity() {
    this.lastActivity = Date.now()
  }

  static isSessionExpired(): boolean {
    return Date.now() - this.lastActivity > this.sessionTimeout
  }

  static async checkSession(): Promise<boolean> {
    // Check if session is expired
    if (this.isSessionExpired()) {
      await this.endSession()
      return false
    }

    // Check if token is valid
    const token = await TokenManager.getAccessToken()
    if (!token || !TokenManager.isValidToken(token)) {
      await this.endSession()
      return false
    }

    return true
  }

  // ✅ Secure session termination
  static async endSession() {
    try {
      // Clear tokens
      await TokenManager.clearTokens()

      // Clear sensitive data
      await this.clearSensitiveData()

      // Reset activity tracking
      this.lastActivity = 0

      console.log('Session ended securely')
    } catch (error) {
      console.error('Error ending session:', error)
    }
  }

  private static async clearSensitiveData() {
    // Clear any cached sensitive data
    // Implementation depends on your data storage strategy
  }

  // ✅ Session monitoring
  static startSessionMonitoring() {
    setInterval(async () => {
      const isValid = await this.checkSession()
      if (!isValid) {
        // Navigate to login screen
        // This would typically be handled by your navigation system
        console.log('Session expired, redirecting to login')
      }
    }, 60000) // Check every minute
  }
}
```

## Debug and Development Security

### Development Security

```typescript
// src/utils/debugSecurity.ts
export class DebugSecurity {
  // ✅ Secure logging
  static secureLog(message: string, data?: any) {
    if (__DEV__) {
      if (data) {
        const maskedData = DataProtection.maskPII(data)
        console.log(message, maskedData)
      } else {
        console.log(message)
      }
    }
  }

  // ✅ Production log filtering
  static productionLog(level: 'info' | 'warn' | 'error', message: string, data?: any) {
    if (__DEV__) {
      console[level](message, data)
    } else {
      // In production, only log errors and send to crash reporting
      if (level === 'error') {
        // Send to crash reporting service
        console.error(message, data)
      }
    }
  }

  // ✅ Remove debug code in production
  static isDebugMode(): boolean {
    return __DEV__
  }

  // ✅ Prevent debug access in production
  static preventDebugAccess() {
    if (!__DEV__) {
      // Disable debug menus, dev tools, etc.
      console.warn = () => {}
      console.log = () => {}
      console.info = () => {}
    }
  }
}
```

## Security Checklist

### Implementation Checklist

- [ ] Authentication tokens stored securely (encrypted storage)
- [ ] Password strength validation implemented
- [ ] Biometric authentication available where appropriate
- [ ] Certificate pinning configured for production
- [ ] Input validation implemented for all forms
- [ ] SQL injection prevention measures in place
- [ ] XSS prevention for any dynamic content
- [ ] File upload validation and restrictions
- [ ] Session timeout and management implemented
- [ ] Sensitive data encrypted at rest
- [ ] PII data masked in logs
- [ ] HTTPS enforced for all network requests
- [ ] Deep link validation implemented
- [ ] Debug code removed from production builds
- [ ] Error messages don't expose sensitive information
- [ ] Rate limiting handled gracefully
- [ ] Proper logout functionality implemented

### Security Testing

```typescript
// __tests__/security.test.ts
import { PasswordSecurity } from '@/utils/passwordSecurity'
import { InputValidation } from '@/utils/inputValidation'

describe('Security Tests', () => {
  describe('Password Security', () => {
    it('should reject weak passwords', () => {
      const result = PasswordSecurity.validatePasswordStrength('123')
      expect(result.isValid).toBe(false)
      expect(result.feedback.length).toBeGreaterThan(0)
    })

    it('should accept strong passwords', () => {
      const result = PasswordSecurity.validatePasswordStrength('MyStr0ng!Pass')
      expect(result.isValid).toBe(true)
      expect(result.score).toBeGreaterThan(5)
    })
  })

  describe('Input Validation', () => {
    it('should sanitize SQL injection attempts', () => {
      const maliciousInput = "'; DROP TABLE users; --"
      const sanitized = InputValidation.sanitizeInput(maliciousInput)
      expect(sanitized).not.toContain('DROP TABLE')
    })

    it('should sanitize XSS attempts', () => {
      const maliciousInput = '<script>alert("xss")</script>'
      const sanitized = InputValidation.sanitizeHTML(maliciousInput)
      expect(sanitized).not.toContain('<script>')
    })
  })
})
```

