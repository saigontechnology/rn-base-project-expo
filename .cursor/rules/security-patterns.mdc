# Security Patterns

## Authentication Security

### Token Management

```typescript
// src/services/auth/tokenManager.ts
import { getData, setData, clearData } from '@/utilities/storage'
import { TOKEN } from '@/constants'

export class TokenManager {
  // ✅ Secure token storage using encrypted storage
  static async storeTokens(accessToken: string, refreshToken: string) {
    try {
      await setData(TOKEN.access_token, accessToken)
      await setData(TOKEN.refresh_token, refreshToken)
    } catch (error) {
      console.error('Token storage failed:', error)
      throw new Error('Failed to store authentication tokens')
    }
  }

  static async getAccessToken(): Promise<string | null> {
    try {
      return await getData<string>(TOKEN.access_token)
    } catch (error) {
      console.error('Token retrieval failed:', error)
      return null
    }
  }

  static async getRefreshToken(): Promise<string | null> {
    try {
      return await getData<string>(TOKEN.refresh_token)
    } catch (error) {
      console.error('Refresh token retrieval failed:', error)
      return null
    }
  }

  static async clearTokens() {
    try {
      await clearData(TOKEN.access_token)
      await clearData(TOKEN.refresh_token)
    } catch (error) {
      console.error('Token clearing failed:', error)
    }
  }

  // ✅ Validate token format and expiration
  static isValidToken(token: string): boolean {
    try {
      // Basic JWT format validation
      const parts = token.split('.')
      if (parts.length !== 3) return false

      // Decode payload to check expiration
      const payload = JSON.parse(atob(parts[1]))
      const currentTime = Math.floor(Date.now() / 1000)

      return payload.exp && payload.exp > currentTime
    } catch {
      return false
    }
  }
}
```

### Password Security

```typescript
// src/utils/passwordSecurity.ts
import CryptoJS from 'crypto-js'

export class PasswordSecurity {
  // ✅ Password strength validation
  static validatePasswordStrength(password: string): {
    isValid: boolean
    score: number
    feedback: string[]
  } {
    const feedback: string[] = []
    let score = 0

    // Length check
    if (password.length >= 8) score += 1
    else feedback.push('Password must be at least 8 characters long')

    // Uppercase check
    if (/[A-Z]/.test(password)) score += 1
    else feedback.push('Password must include uppercase letters')

    // Lowercase check
    if (/[a-z]/.test(password)) score += 1
    else feedback.push('Password must include lowercase letters')

    // Number check
    if (/[0-9]/.test(password)) score += 1
    else feedback.push('Password must include numbers')

    // Special character check
    if (/[@#$!%*?&]/.test(password)) score += 1
    else feedback.push('Password must include special characters')

    // No whitespace
    if (!/\s/.test(password)) score += 1
    else feedback.push('Password should not contain whitespace')

    // Common password check
    if (!this.isCommonPassword(password)) score += 1
    else feedback.push('Password is too common')

    return {
      isValid: score >= 6,
      score,
      feedback,
    }
  }

  private static isCommonPassword(password: string): boolean {
    const commonPasswords = [
      'password',
      '123456',
      'password123',
      'admin',
      'qwerty',
      '12345678',
      '123456789',
      'welcome',
      'login',
      'admin123',
    ]
    return commonPasswords.includes(password.toLowerCase())
  }

  // ✅ Secure password hashing (client-side pre-processing)
  static hashPassword(password: string, salt: string): string {
    // Note: This is for client-side pre-processing only
    // Server should always perform the final hashing
    return CryptoJS.PBKDF2(password, salt, {
      keySize: 256 / 32,
      iterations: 1000,
    }).toString()
  }
}
```

## Data Protection

### Sensitive Data Handling

```typescript
// src/utils/dataProtection.ts
import { getData, setData } from '@/utilities/storage'

export class DataProtection {
  // ✅ Encrypt sensitive data before storage
  static async storeSensitiveData(key: string, data: any) {
    try {
      // In a real app, use proper encryption library
      const encryptedData = this.encrypt(JSON.stringify(data))
      await setData(key, encryptedData)
    } catch (error) {
      console.error('Failed to store sensitive data:', error)
      throw new Error('Data storage failed')
    }
  }

  static async getSensitiveData<T>(key: string): Promise<T | null> {
    try {
      const encryptedData = await getData<string>(key)
      if (!encryptedData) return null

      const decryptedData = this.decrypt(encryptedData)
      return JSON.parse(decryptedData)
    } catch (error) {
      console.error('Failed to retrieve sensitive data:', error)
      return null
    }
  }

  // ✅ Simple encryption (use proper encryption in production)
  private static encrypt(data: string): string {
    // This is a placeholder - use proper encryption library
    // like react-native-crypto-js or @react-native-keychain
    return btoa(data)
  }

  private static decrypt(encryptedData: string): string {
    // This is a placeholder - use proper decryption
    return atob(encryptedData)
  }

  // ✅ Data sanitization
  static sanitizeInput(input: string): string {
    return input
      .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
      .replace(/[<>]/g, '')
      .trim()
  }

  // ✅ PII data masking for logs
  static maskPII(data: any): any {
    const masked = { ...data }

    // Mask common PII fields
    if (masked.phone) {
      masked.phone = masked.phone.replace(/(\d{3})\d{4}(\d{3})/, '$1****$2')
    }

    if (masked.email) {
      masked.email = masked.email.replace(/(.{2}).*(@.*)/, '$1****$2')
    }

    if (masked.password) {
      masked.password = '****'
    }

    return masked
  }
}
```

### Biometric Authentication

```typescript
// src/services/biometrics.ts
import TouchID from 'react-native-touch-id'
import { Alert } from 'react-native'

export class BiometricAuth {
  // ✅ Check biometric availability
  static async isBiometricAvailable(): Promise<boolean> {
    try {
      const biometryType = await TouchID.isSupported()
      return biometryType !== false
    } catch {
      return false
    }
  }

  // ✅ Authenticate with biometrics
  static async authenticate(reason: string): Promise<boolean> {
    try {
      await TouchID.authenticate(reason, {
        title: getString('auth.biometric.title'),
        subTitle: getString('auth.biometric.subtitle'),
        description: reason,
        fallbackLabel: getString('auth.biometric.fallback'),
        cancelLabel: getString('common.cancel'),
        showErrorDialog: true,
        imageColor: '#e00606',
        imageErrorColor: '#ff0000',
      })
      return true
    } catch (error) {
      console.error('Biometric authentication failed:', error)
      return false
    }
  }

  // ✅ Setup biometric authentication
  static async setupBiometric(): Promise<boolean> {
    const isAvailable = await this.isBiometricAvailable()

    if (!isAvailable) {
      Alert.alert(getString('auth.biometric.notAvailable'), getString('auth.biometric.setupDevice'))
      return false
    }

    return new Promise(resolve => {
      Alert.alert(getString('auth.biometric.setup'), getString('auth.biometric.setupDescription'), [
        {
          text: getString('common.cancel'),
          onPress: () => resolve(false),
        },
        {
          text: getString('auth.biometric.enable'),
          onPress: async () => {
            const success = await this.authenticate(getString('auth.biometric.setupReason'))
            resolve(success)
          },
        },
      ])
    })
  }
}
```

## Network Security

### API Security

```typescript
// src/services/networking/security.ts
import { Platform } from 'react-native'

export class NetworkSecurity {
  // ✅ Certificate pinning configuration
  static configureCertificatePinning() {
    // This would typically be configured at the native level
    // or using libraries like react-native-cert-pinner
    console.log('Certificate pinning should be configured at native level')
  }

  // ✅ Request validation
  static validateRequest(url: string, data: any): boolean {
    // Validate URL format
    if (!this.isValidURL(url)) {
      console.error('Invalid URL format:', url)
      return false
    }

    // Validate data size
    if (this.getDataSize(data) > 10 * 1024 * 1024) {
      // 10MB limit
      console.error('Request data too large')
      return false
    }

    return true
  }

  private static isValidURL(url: string): boolean {
    try {
      new URL(url)
      return true
    } catch {
      return false
    }
  }

  private static getDataSize(data: any): number {
    return new Blob([JSON.stringify(data)]).size
  }

  // ✅ Secure headers
  static getSecureHeaders(token?: string): Record<string, string> {
    const headers: Record<string, string> = {
      'Content-Type': 'application/json',
      Accept: 'application/json',
      'X-Requested-With': 'XMLHttpRequest',
      'X-App-Version': '1.0.0', // App version for API compatibility
      'X-Platform': Platform.OS,
    }

    if (token) {
      headers['Authorization'] = `Bearer ${token}`
    }

    return headers
  }
}
```

